#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

VERSION := $(firstword $(subst +ds, ,$(DEB_VERSION_UPSTREAM)))
MAJOR   := $(firstword $(subst ., ,$(VERSION)))
DYLIB   := $(OBJ)/liblz4.$(MAJOR).dylib
SRCS    := lz4.c lz4file.c lz4frame.c lz4hc.c xxhash.c
OBJS    := $(addprefix $(OBJ)/,$(SRCS:.c=.o))
HEADERS := lz4.h lz4hc.h lz4frame.h

$(OBJ)/%.o: $(SRCROOT)/lib/%.c $(wildcard $(SRCROOT)/lib/*.h)
	@mkdir -p $(OBJ)
	$(CC) $(filter-out -Os,$(BASE_CFLAGS)) -O3 -Wall -Wextra -DXXH_NAMESPACE=LZ4_ \
		-c $< -o $@

$(DYLIB): $(OBJS)
	$(CC) $(BASE_LDFLAGS) -dynamiclib -install_name /usr/lib/liblz4.$(MAJOR).dylib \
		-compatibility_version $(MAJOR) -current_version $(VERSION) $^ -o $@

install: $(DYLIB)
	install -d $(ROOT)/usr/lib/pkgconfig $(ROOT)/usr/include
	install -m 755 $(DYLIB) $(ROOT)/usr/lib/
	ln -sf liblz4.$(MAJOR).dylib $(ROOT)/usr/lib/liblz4.dylib
	install -m 644 $(addprefix $(SRCROOT)/lib/,$(HEADERS)) $(ROOT)/usr/include/
	sed -e 's|@PREFIX@|/usr|; s|@LIBDIR@|$${prefix}/lib|; s|@INCLUDEDIR@|$${prefix}/include|' \
		-e 's|@VERSION@|$(VERSION)|' $(SRCROOT)/lib/liblz4.pc.in > $(ROOT)/usr/lib/pkgconfig/liblz4.pc

.PHONY: install
